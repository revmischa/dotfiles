# Route Codex through METR's Middleman (OpenAI Responses API), authenticating with the
# Hawk login's short-lived access token, refreshed by command.
model_provider = "middleman"

[model_providers.middleman]
name = "Middleman"
base_url = "https://middleman.prd.metr.org/openai/v1"
wire_api = "responses"

[model_providers.middleman.auth]
command = "{{ .chezmoi.homeDir }}/.local/bin/hawk-access-token"
timeout_ms = 30000
refresh_interval_ms = 600000
